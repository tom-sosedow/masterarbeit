
.PROGRAM Garnablage ()
  ; ############### program header start ##############
  QTOOL OFF                   ; turn off block tool
  BASE NULL                   ; set base coordinates to (0,0,0,0,0,0)
  ABS.SPEED ON                ; turn on absolute speed
  CP ON                       ; turn on continuous path
  TOOL NULL                   ; set tool coordinates to (0,0,0,0,0,0)
  SPEED 2000 MM/S ALWAYS      ; set robot velocity
  ACCEL 50 ALWAYS             ; set robot acceleration (%)
  DECEL 50 ALWAYS             ; set robot deceleration (%)
  ACCURACY 20 ALWAYS          ; set point accuracy
  ; ############### program header end ################

  CALL get_yp   ; subroutine to get yarn placer
  TOOL yp_tool  ; set tool coordinates

  point .frame = frame_table + TRANS (100, 100) ; store frame (with offset) in local variable

  ; ############# main #############
  JAPPRO .frame + TRANS (1300.0, 250.0, -35.0) + rz(179), 500
LMOVE .frame + TRANS (1300.0, 250.0, -35.0) + rz(179)
; NORMAL ROTATION ###################
LMOVE .frame + TRANS (50.0, 250.0, -35.0) + rz(179)
C1MOVE .frame + TRANS (0.0, 300.0, -35.0) + rz(179)
C2MOVE .frame + TRANS (50.0, 350.0, -35.0) + rz(179)
; NORMAL ROTATION ###################
LMOVE .frame + TRANS (400.0, 300.0, -35.0) + rz(179)
C1MOVE .frame + TRANS (450.0, 350.0, -35.0) + rz(179)
C2MOVE .frame + TRANS (400.0, 400.0, -35.0) + rz(179)
; NORMAL ROTATION ###################
